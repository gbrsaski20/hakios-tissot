+ * XNU maps interrupt-controller MMIO as `soc_base + reg`, where soc_base is
+ * the arm-io "ranges" parent (0x07800000 on tissot, see mkadt.py), so the
+ * ADT carries these as offsets from that base.
+ */
+#define TISSOT_GIC_V2 1
+
+#define TISSOT_GIC_BASE_PADDR     0x0B000000ULL
+#define TISSOT_SOC_BASE_PADDR     0x07800000ULL
+
+#define TISSOT_GIC_DIST_OFFSET    (TISSOT_GIC_BASE_PADDR - TISSOT_SOC_BASE_PADDR) /* 0x03800000 */
+#define TISSOT_GIC_DIST_SIZE      0x1000
+#define TISSOT_GIC_CPU_OFFSET     (TISSOT_GIC_DIST_OFFSET + 0x2000)               /* 0x03802000 */
+#define TISSOT_GIC_CPU_SIZE       0x2000
+
+/* ---- GICD (distributor) register offsets ---- */
+#define TISSOT_GICD_CTLR          0x0000
+#define TISSOT_GICD_TYPER         0x0004
+#define TISSOT_GICD_IIDR          0x0008
+#define TISSOT_GICD_IGROUPR       0x0080  /* +4 per 32 IRQs */
+#define TISSOT_GICD_ISENABLER     0x0100  /* +4 per 32 IRQs */
+#define TISSOT_GICD_ICENABLER     0x0180  /* +4 per 32 IRQs */
+#define TISSOT_GICD_ISPENDR       0x0200  /* +4 per 32 IRQs */
+#define TISSOT_GICD_ICPENDR       0x0280  /* +4 per 32 IRQs */
+#define TISSOT_GICD_IPRIORITYR    0x0400  /* +1 per IRQ */
+#define TISSOT_GICD_ITARGETSR     0x0800  /* +1 per IRQ (banked for PPI) */
+#define TISSOT_GICD_ICFGR         0x0C00  /* +4 per 16 IRQs */
+#define TISSOT_GICD_SGIR          0x0F00
+
+/* ---- GICC (CPU interface) register offsets ---- */
+#define TISSOT_GICC_CTLR          0x0000
+#define TISSOT_GICC_PMR           0x0004
+#define TISSOT_GICC_BPR           0x0008
+#define TISSOT_GICC_IAR           0x000C
+#define TISSOT_GICC_EOIR          0x0010
+#define TISSOT_GICC_RPR           0x0014
+#define TISSOT_GICC_HPPIR         0x0018
+#define TISSOT_GICC_IIDR          0x00FC
+
+/* GICD_CTLR bits */
+#define TISSOT_GICD_CTLR_ENABLE_GRP0  0x1
+
+/* GICC_CTLR bits */
+#define TISSOT_GICC_CTLR_ENABLE_GRP0  0x1
+
+/* GICv2 spurious interrupt ID returned by GICC_IAR when nothing is pending */
+#define TISSOT_GIC_SPURIOUS_IRQ   1023
+
+/* Highest SPI on GIC-400 is 987; round the scan up to 1024 for alignment */
+#define TISSOT_GIC_MAX_IRQ        1024
+
+/* Default priority: mid-range, above nothing in particular. Apple uses 0xA0. */
+#define TISSOT_GIC_DEFAULT_PRIO   0xA0
+
+/*
+ * ARM generic timer PPIs (GICv2 INTIDs 16..31):
+ *   26 = PPI 10 -> non-secure physical timer  (CNTP_*)
+ *   27 = PPI 11 -> secure physical timer      (CNTPS_*)
+ *   28 = PPI 12 -> virtual timer              (CNTV_*)
+ *   29 = PPI 13 -> hypervisor timer           (CNTHP_*)
+ *
+ * XNU's ARM_ARCH_TIMER code drives the non-secure physical timer, so 26 is
+ * the one that must fire. 27 is enabled as well because Qualcomm's
+ * bootloader may leave the secure timer armed; leaving it masked would
+ * produce a permanent interrupt storm instead of a clean boot.
+ */
+#define TISSOT_IRQ_TIMER_NS       26
+#define TISSOT_IRQ_TIMER_S        27
