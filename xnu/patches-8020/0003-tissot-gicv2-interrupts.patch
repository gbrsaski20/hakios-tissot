+#elif defined(ARM64_BOARD_CONFIG_TISSOT)
+/* ==========================================================================
+ * GIC-400 (GICv2) driver — Xiaomi Mi A1 (MSM8953)
+ * ==========================================================================
+ *
+ * Why this exists
+ * ---------------
+ * XNU ships exactly two interrupt-controller paths:
+ *
+ *   1. Apple AIC  — proprietary, only on Apple SoCs (pexpert/pexpert/arm64/AIC.h)
+ *   2. GICv3      — system-register interface, guarded by HAS_GIC_V3 and only
+ *                   enabled by VMAPPLE.h (Apple's macOS VM platform)
+ *
+ * MSM8953 has an ARM GIC-400, which is GICv2: the CPU interface is MMIO
+ * (GICC_IAR / GICC_EOIR), not the ICC_*_EL1 system registers. Neither
+ * existing path works, so without this driver pe_init_fiq() would be an
+ * empty function and the kernel would never take a timer interrupt — it
+ * would print a few lines to UART and then hang forever with IRQs masked.
+ *
+ * What this does
+ * --------------
+ * On the boot processor: disables the distributor, puts every SPI in group 0
+ * with a uniform priority and targets them at CPU 0, then enables the
+ * distributor. On every CPU (including the boot one): programs its private
+ * CPU interface and enables the ARM generic-timer PPIs.
+ *
+ * Group 0 vs group 1
+ * ------------------
+ * Group 0 is the FIQ group and is normally secure-only. Android boots the
+ * non-secure world, so on real hardware the non-secure alias of GICD_IGROUPR
+ * may read back as "group 1" no matter what we write, and GICC_CTLR bit 0
+ * (EnableGrp0) may be RAZ/WI. If that turns out to be the case on the device,
+ * the fix is to switch this driver to group 1 / IRQ (see the TISSOT_GIC_GROUP1
+ * note below) and route through ICC_* — which is exactly what
+ * docs/XNU8020-PORT-PLAN.md flags as the first thing to check on hardware.
+ *
+ * This code has NOT been run on hardware. Every register offset comes from
+ * the ARM GICv2 architecture specification and the mainline Linux
+ * msm-qgic2 binding.
+ */
+
+#ifndef TISSOT_GIC_GROUP1
+#define TISSOT_GIC_GROUP1 0
+#endif
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+
+static uint32_t
+tissot_gicd_read32(uint32_t offset)
+{
+	return *((volatile uint32_t *)(gicd_base + offset));
+}
+
+static void
+tissot_gicd_write32(uint32_t offset, uint32_t value)
+{
+	*((volatile uint32_t *)(gicd_base + offset)) = value;
+}
+
+static uint32_t
+tissot_gicc_read32(uint32_t offset)
+{
+	return *((volatile uint32_t *)(gicc_base + offset));
+}
+
+static void
+tissot_gicc_write32(uint32_t offset, uint32_t value)
+{
+	*((volatile uint32_t *)(gicc_base + offset)) = value;
+}
+
+/*
+ * Number of 32-IRQ banks the distributor actually implements, taken from
+ * GICD_TYPER[4:0] ("ITLinesNumber"). GIC-400 on MSM8953 reports 0x1F for
+ * 1024 IRQs, but reading it keeps the loops honest on any part.
+ */
+static uint32_t
+tissot_gic_num_banks(void)
+{
+	uint32_t typer = tissot_gicd_read32(TISSOT_GICD_TYPER);
+	uint32_t banks = (typer & 0x1F) + 1;
+
+	if (banks > (TISSOT_GIC_MAX_IRQ / 32)) {
+		banks = TISSOT_GIC_MAX_IRQ / 32;
+	}
+	return banks;
+}
+
+/* Distributor-wide setup. Boot processor only. */
+static void
+tissot_gic_init_distributor(void)
+{
+	uint32_t banks = tissot_gic_num_banks();
+	uint32_t i;
+
+	/* Quiesce the distributor before touching any configuration register. */
+	tissot_gicd_write32(TISSOT_GICD_CTLR, 0);
+
+	/*
+	 * Group + enable + pending state for every bank.
+	 *
+	 * Banks 0 covers INTIDs 0..31 (SGIs and PPIs). Those are banked
+	 * per-CPU, so the boot processor can only configure its own copy —
+	 * secondary CPUs redo bank 0 in tissot_gic_init_cpu_interface().
+	 */
+	for (i = 0; i < banks; i++) {
+		uint32_t off = i * 4;
+
+		/*
+		 * IGROUPR bit = 1 means group 1, bit = 0 means group 0.
+		 *
+		 * Group 0 build: every bit 0.
+		 * To switch this driver to group 1 / IRQ instead, write
+		 * 0xFFFFFFFFu here and change GICC_CTLR below to bit 1
+		 * (EnableGrp1). Do that only if the device turns out to expose
+		 * group 0 as secure-only; see the "Group 0 vs group 1" note at
+		 * the top of this block.
+		 */
+		tissot_gicd_write32(TISSOT_GICD_IGROUPR + off,
+		    TISSOT_GIC_GROUP1 ? 0xFFFFFFFFu : 0);
+		tissot_gicd_write32(TISSOT_GICD_ICENABLER + off, 0xFFFFFFFFu);
+		tissot_gicd_write32(TISSOT_GICD_ICPENDR + off, 0xFFFFFFFFu);
+	}
+
+	/* Uniform priority for every INTID (byte-wide, so 1024 bytes). */
+	for (i = 0; i < TISSOT_GIC_MAX_IRQ; i += 4) {
+		tissot_gicd_write32(TISSOT_GICD_IPRIORITYR + i,
+		    TISSOT_GIC_DEFAULT_PRIO * 0x01010101u);
+	}
+
+	/* Target every SPI at CPU 0; PPI/SGI targets are banked and ignored. */
+	for (i = 32; i < TISSOT_GIC_MAX_IRQ; i += 4) {
+		tissot_gicd_write32(TISSOT_GICD_ITARGETSR + i, 0x01010101u);
+	}
+
+	/*
+	 * Every SPI level-triggered (ICFGR bit = 0). Edge-triggered is only
+	 * correct for a handful of GPIO lines we do not drive yet.
+	 */
+	for (i = 32; i < TISSOT_GIC_MAX_IRQ; i += 16) {
+		tissot_gicd_write32(TISSOT_GICD_ICFGR + (i / 16) * 4, 0);
+	}
+
+	tissot_gicd_write32(TISSOT_GICD_CTLR, TISSOT_GICD_CTLR_ENABLE_GRP0);
+}
+
+/* Per-CPU setup: CPU interface + private PPIs. */
+static void
+tissot_gic_init_cpu_interface(void)
+{
+	/*
+	 * Bank 0 (INTIDs 0..31) holds the SGIs and PPIs. ICFGR for PPIs is
+	 * 2 bits per interrupt starting at 0x0C04; 0b10 = level-triggered for
+	 * the generic-timer PPIs, which is what the ARM architecture requires.
+	 */
+	uint32_t icfgr = tissot_gicd_read32(TISSOT_GICD_ICFGR + 4);
+
+	icfgr |= (2u << ((TISSOT_IRQ_TIMER_NS % 16) * 2));
+	icfgr |= (2u << ((TISSOT_IRQ_TIMER_S % 16) * 2));
+	tissot_gicd_write32(TISSOT_GICD_ICFGR + 4, icfgr);
+
+	/* Priority for the timer PPIs (byte-wide registers). */
+	tissot_gicd_write32(TISSOT_GICD_IPRIORITYR + (TISSOT_IRQ_TIMER_NS & ~3u),
+	    TISSOT_GIC_DEFAULT_PRIO * 0x01010101u);
+
+	/* Enable the generic-timer PPIs on this CPU. */
+	tissot_gicd_write32(TISSOT_GICD_ISENABLER, (1u << TISSOT_IRQ_TIMER_NS) |
+	    (1u << TISSOT_IRQ_TIMER_S));
+
+	/* Clear any stale pending state on them. */
+	tissot_gicd_write32(TISSOT_GICD_ICPENDR, (1u << TISSOT_IRQ_TIMER_NS) |
+	    (1u << TISSOT_IRQ_TIMER_S));
+
+	/* CPU interface: disabled -> programmed -> enabled. */
+	tissot_gicc_write32(TISSOT_GICC_CTLR, 0);
+
+	/* Accept every priority (lowest priority mask). */
+	tissot_gicc_write32(TISSOT_GICC_PMR, 0xFF);
+
+	/* No preemption: BPR 0 keeps a single priority group. */
+	tissot_gicc_write32(TISSOT_GICC_BPR, 0);
+
+	tissot_gicc_write32(TISSOT_GICC_CTLR, TISSOT_GICC_CTLR_ENABLE_GRP0);
+}
+
+void
+pe_init_fiq()
+{
+	DTEntry entry;
+	void const *prop;
+	unsigned int prop_size;
+	vm_offset_t soc_base_phys;
+	uint64_t gicd_off, gicd_size, gicc_off, gicc_size;
+	int error;
+
+	/*
+	 * Only the boot processor sets up the distributor. Secondary CPUs see
+	 * gicd_base already non-zero and jump straight to their private
+	 * interface, which also avoids the non-thread-safe SecureDT* routines
+	 * racing between cores (same reasoning as the GICv3 path above).
+	 */
+	if (!gicd_base) {
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find /arm-io/gic node in device tree",
+			    __func__);
+		}
+
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in device tree",
+			    __func__);
+		}
+
+		/* GICv2 reg = <GICD base, GICD size, GICC base, GICC size> */
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: GIC reg property is %u bytes, expected 32",
+			    __func__, prop_size);
+		}
+
+		soc_base_phys = pe_arm_get_soc_base_phys();
+		if (soc_base_phys == 0) {
+			panic("%s: arm-io soc base is 0; device tree is broken",
+			    __func__);
+		}
+
+		gicd_off = ((uint64_t const *)prop)[0];
+		gicd_size = ((uint64_t const *)prop)[1];
+		gicc_off = ((uint64_t const *)prop)[2];
+		gicc_size = ((uint64_t const *)prop)[3];
+
+		gicd_base = ml_io_map(soc_base_phys + gicd_off, gicd_size);
+		if (!gicd_base) {
+			panic("%s: cannot map GIC distributor at 0x%llx",
+			    __func__, (unsigned long long)(soc_base_phys + gicd_off));
+		}
+
+		gicc_base = ml_io_map(soc_base_phys + gicc_off, gicc_size);
+		if (!gicc_base) {
+			panic("%s: cannot map GIC CPU interface at 0x%llx",
+			    __func__, (unsigned long long)(soc_base_phys + gicc_off));
+		}
+
+		tissot_gic_init_distributor();
+	}
+
+	tissot_gic_init_cpu_interface();
+}
+
+/*
+ * Acknowledge and complete an interrupt.
+ *
+ * sleh_irq() calls these from osfmk/arm64/sleh.c in place of the GICv3
+ * ICC_IAR0_EL1 / ICC_EOIR0_EL1 accesses it uses on Apple platforms.
+ */
+uint32_t
+pe_gic_ack_irq(void)
+{
+	return tissot_gicc_read32(TISSOT_GICC_IAR);
+}
+
+void
+pe_gic_eoi_irq(uint32_t iar)
+{
+	if (iar == TISSOT_GIC_SPURIOUS_IRQ) {
+		return;
+	}
+
+	tissot_gicc_write32(TISSOT_GICC_EOIR, iar);
+}
+
 #else
