--- a/pexpert/pexpert/arm64/TISSOT.h
+++ b/pexpert/pexpert/arm64/TISSOT.h
@@ -0,0 +1,58 @@
+/*
+ * Copyright (c) 2026 HakiOS project. All rights reserved.
+ *
+ * TISSOT.h — board configuration for Xiaomi Mi A1 (Qualcomm MSM8953).
+ *
+ * MSM8953 (Snapdragon 625) is 8x Cortex-A53, ARMv8.0-A, single cluster.
+ * It has no Pointer Authentication and no Apple monitor, so this file is
+ * modelled on the BCM2837 (Raspberry Pi 3) config — also a Cortex-A53.
+ *
+ * Console UART: BLSP1 UART1, physical base 0x078AF000 (ttyHSL0 in the
+ * stock Android kernel). Verified against the stock tissot device tree.
+ *
+ * This file is added by xnu/patches-8020/0001-add-tissot-board-config.patch.
+ */
+
+#ifndef _PEXPERT_ARM_TISSOT_H
+#define _PEXPERT_ARM_TISSOT_H
+
+#define NO_MONITOR 1
+#define NO_ECORE 1
+
+#define TISSOT 1
+#define MSM8953 1
+
+#define ARM_ARCH_TIMER
+
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM64_PMAP_SUBPAGE_L1__ 1
+
+#ifndef ASSEMBLER
+
+/* ---- debug console: BLSP1 UART1 @ 0x078AF000 ---- */
+#define TISSOT_UART_BASE_PADDR    0x078AF000ULL
+#define TISSOT_UART_SIZE          0x200
+
+#define TISSOT_BREAK              asm volatile("brk #0");
+
+#define TISSOT_PUT32(addr, value) do { *((volatile uint32_t *)(addr)) = (value); } while (0)
+#define TISSOT_GET32(addr)        *((volatile uint32_t *)(addr))
+
+/*
+ * Panic log buffer.
+ * TODO(tissot): pick a DRAM window that the bootloader leaves untouched and
+ * that the kernel's early VM does not map. 0x9FF00000 (top of the 4 GiB
+ * physical window, just below the 0xA0000000 peripheral block) is a
+ * placeholder — it MUST be validated against the real memory map before
+ * relying on panic logs.
+ */
+#define PLATFORM_PANIC_LOG_PADDR  0x9FF00000ULL
+#define PLATFORM_PANIC_LOG_SIZE   16384
+
+#endif /* ! ASSEMBLER */
+
+#endif /* ! _PEXPERT_ARM_TISSOT_H */
