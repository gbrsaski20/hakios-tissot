+/*
+ * MSM UARTDM register offsets, matching the Linux driver
+ * drivers/tty/serial/msm_serial_hs.c (what Android uses for ttyHSL0 on
+ * this SoC).
+ *
+ * TODO(tissot): verify every offset on hardware before trusting serial.
+ */
+#define TISSOT_UART_DM_MR         0x00
+#define TISSOT_UART_DM_IPR        0x04
+#define TISSOT_UART_DM_SR         0x08
+#define TISSOT_UART_DM_CR         0x0C
+#define TISSOT_UART_DM_RF         0x70  /* read:  RX FIFO */
+#define TISSOT_UART_DM_TF         0x70  /* write: TX FIFO */
+
+/* UARTDM_SR bits */
+#define TISSOT_UART_DM_SR_RX_READY  0x01
+#define TISSOT_UART_DM_SR_TX_READY  0x04
+
+/* UARTDM_CR bits */
+#define TISSOT_UART_DM_CR_RX_ENABLE 0x01
+#define TISSOT_UART_DM_CR_TX_ENABLE 0x04
+
 #define TISSOT_BREAK              asm volatile("brk #0");
 
 #define TISSOT_PUT32(addr, value) do { *((volatile uint32_t *)(addr)) = (value); } while (0)
