+/****************************************************************************/
+#ifdef ARM64_BOARD_CONFIG_TISSOT
+#include <pexpert/arm64/TISSOT.h>
+
+/*
+ * Xiaomi Mi A1 (tissot) — BLSP1 UART1 debug console (ttyHSL0, 0x078AF000).
+ *
+ * The Qualcomm bootloader (ABL) has already programmed the baud rate because
+ * `console=ttyHSL0,115200,n8` is on the kernel command line, so init() only
+ * has to make sure the transmitter is enabled. Re-programming the divisor
+ * here would risk breaking the console the bootloader set up.
+ *
+ * NOTE: this driver is a DRAFT. It has not been compiled or run on hardware.
+ * The register offsets follow msm_serial_hs.c and must be validated.
+ */
+vm_offset_t tissot_uart_base_vaddr = 0;
+
+static unsigned int
+tissot_uart_tr0(void)
+{
+	return (unsigned int) (TISSOT_GET32(tissot_uart_base_vaddr + TISSOT_UART_DM_SR)
+	    & TISSOT_UART_DM_SR_TX_READY);
+}
+
+static void
+tissot_uart_td0(uint8_t c)
+{
+	while (!tissot_uart_tr0()) {
+		/* spin until the TX FIFO has room */
+	}
+	TISSOT_PUT32(tissot_uart_base_vaddr + TISSOT_UART_DM_TF, (uint32_t) c);
+}
+
+static unsigned int
+tissot_uart_rr0(void)
+{
+	return (unsigned int) (TISSOT_GET32(tissot_uart_base_vaddr + TISSOT_UART_DM_SR)
+	    & TISSOT_UART_DM_SR_RX_READY);
+}
+
+static uint8_t
+tissot_uart_rd0(void)
+{
+	return (uint8_t) TISSOT_GET32(tissot_uart_base_vaddr + TISSOT_UART_DM_RF);
+}
+
+static void
+tissot_uart_init(void)
+{
+	uint32_t cr = TISSOT_GET32(tissot_uart_base_vaddr + TISSOT_UART_DM_CR);
+
+	cr |= (TISSOT_UART_DM_CR_TX_ENABLE | TISSOT_UART_DM_CR_RX_ENABLE);
+	TISSOT_PUT32(tissot_uart_base_vaddr + TISSOT_UART_DM_CR, cr);
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) tissot_uart_serial_functions =
+{
+	.init = tissot_uart_init,
+	.transmit_ready = tissot_uart_tr0,
+	.transmit_data = tissot_uart_td0,
+	.receive_ready = tissot_uart_rr0,
+	.receive_data = tissot_uart_rd0,
+	.device = SERIAL_TISSOT_UART
+};
+
+#endif /* ARM64_BOARD_CONFIG_TISSOT */
+
 /*****************************************************************************/
 
