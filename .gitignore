# .gitignore — HakiOS / tissot

# ---------------------------------------------------------------------------
# Berkas milik Apple / Xiaomi — TIDAK PERNAH di-commit
# ---------------------------------------------------------------------------
*.ipsw
*.fdmdownload
*.crdownload
*.part
*.tgz

# Firmware dari perangkat sendiri
fw-*/

# ---------------------------------------------------------------------------
# XNU source (diunduh oleh xnu/apply-8020.sh, ~77 MB)
# ---------------------------------------------------------------------------
xnu-src-8020/
xnu-deps/build/
BUILD/

# ---------------------------------------------------------------------------
# Artefak build tissot (semua bisa dibuat ulang — lihat prebuilt/README.md)
# ---------------------------------------------------------------------------
prebuilt/*.Image
prebuilt/*.img
prebuilt/*.dtb
prebuilt/*.dts
prebuilt/*.adt
prebuilt/*.cpio.gz
!prebuilt/README.md

# Device tree / firmware hasil ekstraksi IPSW
devices/tissot/dt/*.img
devices/tissot/dt/*.dtb
devices/tissot/dt/*.adt
devices/tissot/dt/*.im4p
devices/tissot/dt/*.lzfse
*.simg

# ---------------------------------------------------------------------------
# Artefak kompilasi umum
# ---------------------------------------------------------------------------
*.o
*.a
*.so
*.dylib
*.rej
*.orig
__pycache__/
*.pyc

# Backup / device-specific
backup/
recovery/

# Logs
logs/*.log
logs/*.txt

# OS-specific
.DS_Store
Thumbs.db
*.swp
*~

# IDE
.vscode/
.idea/

# Catatan internal agent (bukan bagian dari proyek)
.workbuddy-ai/

# Klon dependency build (cctools/ld64 untuk host Linux), bukan source proyek
cctools-port/
