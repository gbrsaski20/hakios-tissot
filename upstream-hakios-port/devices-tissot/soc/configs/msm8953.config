# HakiOS fragment: the msm8953 family -- what is true of the SoC, whatever device it is in.
#
# Hardware facts below are from the Linux DTS (kernel tree lineage-21, arch/arm64/boot/dts/qcom/msm8953.dtsi unless noted).
# They are a reference, NOT verified on a phone, and nothing in the kernel reads them yet.
#   qcom,msm-id            <293 0>                          msm8953.dtsi:25
#   interrupt controller   qcom,msm-qgic2 (GICv2 style)     msm8953.dtsi:250-257
#                          distributor 0x0b000000, CPU interface 0x0b002000
#   arch timer             arm,armv8-timer, 19.2 MHz        msm8953.dtsi:286-291
#   console UART           qcom,msm-uartdm-v1.4 @ 0x078af000 (blsp1_uart0)   msm8953.dtsi:546-548
#   CPUs                   arm,cortex-a53                   msm8953-cpu.dtsi:57
# The common kernel has a GICv3 driver only (xnu/files/osfmk/arm64/gic_v3_irq.c); GICv2 support does not exist yet.
CONFIG_SOC="msm8953"
